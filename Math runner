<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Математический Забег</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1b1340;
    --good:#2ee6a6;
    --bad:#ff5277;
    --gold:#ffc23d;
    --paper:#fff7ec;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overflow:hidden;background:#101030;
    font-family:'Baloo 2',system-ui,-apple-system,sans-serif;
    color:var(--ink);user-select:none}
  #game{position:fixed;inset:0}
  canvas{display:block;width:100%;height:100%;touch-action:none}

  /* ---------- HUD ---------- */
  .hud{position:fixed;inset:0;pointer-events:none;z-index:5}
  #count{
    position:absolute;top:18px;left:50%;transform:translateX(-50%);
    font-weight:800;font-size:clamp(44px,11vw,84px);line-height:1;
    color:#fff;text-shadow:0 4px 0 rgba(0,0,0,.22), 0 0 22px rgba(120,90,255,.5);
    letter-spacing:1px;transition:color .15s ease;
  }
  #count .lbl{display:block;font-size:.26em;font-weight:700;letter-spacing:3px;
    opacity:.85;text-shadow:0 2px 0 rgba(0,0,0,.2);margin-top:-2px}
  #count.bump{animation:bump .3s ease}
  @keyframes bump{0%{transform:translateX(-50%) scale(1)}40%{transform:translateX(-50%) scale(1.32)}100%{transform:translateX(-50%) scale(1)}}

  #banner{
    position:absolute;top:38%;left:50%;transform:translate(-50%,-50%) scale(.7);
    text-align:center;color:#fff;font-weight:800;font-size:clamp(28px,7vw,52px);
    text-shadow:0 5px 0 rgba(0,0,0,.28);opacity:0;transition:none;white-space:nowrap}
  #banner.show{animation:pop 1.4s ease forwards}
  @keyframes pop{0%{opacity:0;transform:translate(-50%,-50%) scale(.6)}
    18%{opacity:1;transform:translate(-50%,-50%) scale(1.08)}
    30%{transform:translate(-50%,-50%) scale(1)}
    78%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) scale(1)}}

  #progress{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);
    width:min(72%,460px);height:12px;border-radius:99px;background:rgba(255,255,255,.22);
    box-shadow:inset 0 2px 4px rgba(0,0,0,.25)}
  #progress i{position:absolute;left:0;top:0;height:100%;width:0;border-radius:99px;
    background:linear-gradient(90deg,#7c5cff,#2ee6a6);transition:width .1s linear}
  #progress span{position:absolute;left:50%;top:-26px;transform:translateX(-50%);
    color:#fff;font-weight:700;font-size:14px;letter-spacing:2px;
    text-shadow:0 2px 0 rgba(0,0,0,.25);opacity:.9}

  /* ---------- overlays ---------- */
  .screen{position:fixed;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;
    padding:24px;background:radial-gradient(120% 120% at 50% 0%,rgba(124,92,255,.5),rgba(16,16,48,.86));
    backdrop-filter:blur(3px)}
  .card{background:var(--paper);border-radius:28px;max-width:440px;width:100%;
    padding:30px 28px 26px;text-align:center;box-shadow:0 22px 60px rgba(0,0,0,.45),0 0 0 6px rgba(255,255,255,.12);
    transform:translateY(0)}
  .card h1{font-size:clamp(30px,7vw,42px);font-weight:800;line-height:1.02;margin-bottom:6px}
  .card h1 em{font-style:normal;color:#7c5cff}
  .tag{display:inline-block;font-weight:700;font-size:13px;letter-spacing:3px;text-transform:uppercase;
    color:#9b87ff;margin-bottom:10px}
  .card p{font-size:16px;line-height:1.5;color:#5b5478;margin:0 auto 6px;max-width:340px;font-weight:500}
  .rules{display:flex;flex-direction:column;gap:8px;margin:18px 0 20px;text-align:left}
  .rule{display:flex;align-items:center;gap:12px;background:#fff;border-radius:16px;padding:10px 14px;
    font-weight:600;font-size:14.5px;color:#3a335c;box-shadow:0 2px 0 rgba(0,0,0,.05)}
  .chip{flex:0 0 auto;min-width:46px;height:34px;border-radius:11px;display:flex;align-items:center;
    justify-content:center;font-weight:800;color:#fff;font-size:16px}
  .chip.g{background:var(--good)} .chip.r{background:var(--bad)} .chip.y{background:var(--gold)}
  .btn{appearance:none;border:0;cursor:pointer;font-family:inherit;font-weight:800;
    background:#7c5cff;color:#fff;font-size:21px;padding:15px 20px;border-radius:18px;width:100%;
    box-shadow:0 6px 0 #5a3ee0, 0 12px 24px rgba(124,92,255,.5);transition:transform .08s, box-shadow .08s}
  .btn:active{transform:translateY(4px);box-shadow:0 2px 0 #5a3ee0,0 6px 14px rgba(124,92,255,.5)}
  .stat{font-size:15px;color:#7a7398;font-weight:600;margin:2px 0}
  .stat b{color:#1b1340;font-weight:800}
  .verdict{font-size:34px;font-weight:800;margin:4px 0 6px}
  .verdict.win{color:#11b07a} .verdict.lose{color:#e23a5e}
  .hidden{display:none!important}
  .hint{position:fixed;left:50%;bottom:54px;transform:translateX(-50%);z-index:6;
    color:#fff;font-weight:700;font-size:15px;letter-spacing:1px;text-shadow:0 2px 0 rgba(0,0,0,.3);
    background:rgba(0,0,0,.28);padding:8px 16px;border-radius:99px;opacity:0;transition:opacity .4s}
  .hint.show{opacity:1}
</style>
</head>
<body>
<div id="game"></div>

<!-- HUD -->
<div class="hud">
  <div id="count">1<span class="lbl">ЧЕЛОВЕЧКОВ</span></div>
  <div id="banner"></div>
  <div id="progress"><span>ПУТЬ</span><i></i></div>
</div>
<div class="hint" id="hint">Веди мышью / A · D — выбирай ворота</div>

<!-- START -->
<div class="screen" id="start">
  <div class="card">
    <span class="tag">Crowd Runner</span>
    <h1>Математический <em>Забег</em></h1>
    <p>Твоя толпа бежит вперёд. На воротах — действия. Веди людей через выгодные, чтобы собрать армию.</p>
    <div class="rules">
      <div class="rule"><span class="chip g">+5</span> Прибавляет человечков</div>
      <div class="rule"><span class="chip r">−2</span> Отнимает человечков</div>
      <div class="rule"><span class="chip y">×2</span> Умножает толпу — самое мощное</div>
      <div class="rule"><span class="chip r">÷2</span> Делит толпу пополам</div>
      <div class="rule"><span class="chip g">🧱</span> В конце — стены и босс. Чем больше армия, тем дальше пройдёшь</div>
    </div>
    <button class="btn" id="play">Играть</button>
  </div>
</div>

<!-- RESULT -->
<div class="screen hidden" id="result">
  <div class="card">
    <div class="verdict" id="verdict">Победа!</div>
    <p id="resultText">—</p>
    <div style="margin:14px 0 18px">
      <div class="stat">Армия в финале: <b id="rArmy">0</b></div>
      <div class="stat">Стены пробиты: <b id="rWalls">0 / 0</b></div>
      <div class="stat">Босс: <b id="rBoss">—</b></div>
    </div>
    <button class="btn" id="again">Ещё раз</button>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
"use strict";

// ---------------------------------------------------------------------------
//  НАСТРОЙКИ УРОВНЯ
// ---------------------------------------------------------------------------
const LANE = 3.4;              // половина ширины дорожки
const RUN_SPEED = 12;          // скорость бега вперёд (по -z)
const START_COUNT = 1;
const MAX_VISIBLE = 60;        // максимум отрисованных человечков

// ворота: пары [левое, правое]. op = {t:'add|sub|mul|div', v:число}
function G(t,v){return {t:t,v:v};}
const GATE_DEFS = [
  [G('add',8),  G('sub',3) ],
  [G('mul',2),  G('add',4) ],
  [G('add',12), G('sub',5) ],
  [G('mul',3),  G('div',2) ],
  [G('add',20), G('mul',2) ],
  [G('add',30), G('sub',10)],
  [G('mul',2),  G('div',2) ],
  [G('add',40), G('add',15)],
];
const GATE_Z0 = -20, GATE_DZ = -14;     // позиции ворот
const WALL_Z  = GATE_Z0 + GATE_DZ*GATE_DEFS.length - 18;   // первая (ближняя) стена

const WALL_COUNT = 3, WALL_HP = 50;
const WALL_SPACING = 5;                  // расстояние между стенами вдоль пути
const TOTAL_WALL_HP = WALL_COUNT * WALL_HP;   // 150 — порог пробить стены
const BOSS_HP = 220;                          // порог победить босса
const BOSS_Z  = WALL_Z - (WALL_COUNT-1)*WALL_SPACING - 18;

// ---------------------------------------------------------------------------
//  THREE.JS СЦЕНА
// ---------------------------------------------------------------------------
const container = document.getElementById('game');
const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
container.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color('#a7d8ff');
scene.fog = new THREE.Fog('#a7d8ff', 60, 175);

const camera = new THREE.PerspectiveCamera(58, 1, 0.1, 400);

// свет
const hemi = new THREE.HemisphereLight('#ffffff', '#8fb8ff', 1.05);
scene.add(hemi);
const sun = new THREE.DirectionalLight('#fff3d6', 1.1);
sun.position.set(-8, 22, 14);
scene.add(sun);

// небо-градиент (большой купол)
(function sky(){
  const c = document.createElement('canvas'); c.width=4; c.height=256;
  const g = c.getContext('2d').createLinearGradient(0,0,0,256);
  g.addColorStop(0,'#6fc0ff'); g.addColorStop(.55,'#a7d8ff'); g.addColorStop(1,'#ffe9c2');
  const ctx=c.getContext('2d'); ctx.fillStyle=g; ctx.fillRect(0,0,4,256);
  const tex=new THREE.CanvasTexture(c);
  const dome=new THREE.Mesh(new THREE.SphereGeometry(300,16,16),
    new THREE.MeshBasicMaterial({map:tex,side:THREE.BackSide,fog:false}));
  scene.add(dome);
})();

// дорожка
const trackMat = new THREE.MeshStandardMaterial({color:'#c9a26b',roughness:1});
const track = new THREE.Mesh(new THREE.PlaneGeometry(LANE*2+1.4, 320), trackMat);
track.rotation.x = -Math.PI/2; track.position.set(0,0,-130);
scene.add(track);
// серединная полоса
const stripe = new THREE.Mesh(new THREE.PlaneGeometry(0.18,320),
  new THREE.MeshStandardMaterial({color:'#fff7ec',roughness:1}));
stripe.rotation.x=-Math.PI/2; stripe.position.set(0,0.02,-130); scene.add(stripe);
// трава по бокам
const grassMat=new THREE.MeshStandardMaterial({color:'#5fc46b',roughness:1});
[-1,1].forEach(s=>{
  const g=new THREE.Mesh(new THREE.PlaneGeometry(60,320),grassMat);
  g.rotation.x=-Math.PI/2; g.position.set(s*(LANE+30.7),-0.02,-130); scene.add(g);
});
// деревья-кустики для движения
for(let i=0;i<40;i++){
  const side = i%2?1:-1;
  const tree=new THREE.Group();
  const trunk=new THREE.Mesh(new THREE.CylinderGeometry(.2,.28,1.2,6),
    new THREE.MeshStandardMaterial({color:'#8a5a33'}));
  trunk.position.y=.6;
  const top=new THREE.Mesh(new THREE.ConeGeometry(1.1,2.2,7),
    new THREE.MeshStandardMaterial({color:'#3fae5a'}));
  top.position.y=2.1;
  tree.add(trunk,top);
  tree.position.set(side*(LANE+2.5+Math.random()*5), 0, 8 - i*7.5);
  tree.scale.setScalar(.8+Math.random()*.7);
  scene.add(tree);
}

// мягкая тень-блоб под толпой
const blob = new THREE.Mesh(new THREE.CircleGeometry(2.4,24),
  new THREE.MeshBasicMaterial({color:'#000',transparent:true,opacity:.18}));
blob.rotation.x=-Math.PI/2; blob.position.y=0.03; scene.add(blob);

// ---------------------------------------------------------------------------
//  ТОЛПА ЧЕЛОВЕЧКОВ
// ---------------------------------------------------------------------------
const bodyGeo = new THREE.CylinderGeometry(0.26,0.3,0.9,8);
const headGeo = new THREE.SphereGeometry(0.27,10,10);
const skinMat = new THREE.MeshStandardMaterial({color:'#ffd9a8',roughness:.9});

const crowdGroup = new THREE.Group(); scene.add(crowdGroup);
const runners = [];
function makeRunner(){
  const g = new THREE.Group();
  const hue = 0.5 + (Math.random()-0.5)*0.06;
  const col = new THREE.Color().setHSL(hue, 0.7, 0.5);
  const body = new THREE.Mesh(bodyGeo, new THREE.MeshStandardMaterial({color:col,roughness:.7}));
  body.position.y=0.62;
  const head = new THREE.Mesh(headGeo, skinMat); head.position.y=1.28;
  g.add(body, head);
  g.userData.phase = Math.random()*Math.PI*2;
  crowdGroup.add(g); runners.push(g);
  return g;
}
for(let i=0;i<MAX_VISIBLE;i++){ const r=makeRunner(); r.visible=false; }

// слоты-формация (спираль), чтобы толпа выглядела плотной
const slots=[];
(function(){
  slots.push([0,0]);
  let ring=1;
  while(slots.length<MAX_VISIBLE){
    const n=Math.floor(ring*6); 
    for(let i=0;i<n && slots.length<MAX_VISIBLE;i++){
      const a=(i/n)*Math.PI*2;
      const rad=ring*0.62;
      slots.push([Math.cos(a)*rad, Math.sin(a)*rad]);
    }
    ring++;
  }
})();

// ---------------------------------------------------------------------------
//  ВОРОТА
// ---------------------------------------------------------------------------
function opColor(op){
  if(op.t==='add') return '#2ee6a6';
  if(op.t==='mul') return '#ffc23d';
  return '#ff5277'; // sub / div
}
function opLabel(op){
  if(op.t==='add') return '+'+op.v;
  if(op.t==='sub') return '\u2212'+op.v;   // минус
  if(op.t==='mul') return '\u00D7'+op.v;   // ×
  return '\u00F7'+op.v;                    // ÷
}
function gateTexture(op){
  const S=512;
  const c=document.createElement('canvas'); c.width=S; c.height=S;
  const x=c.getContext('2d');
  x.fillStyle=opColor(op); x.fillRect(0,0,S,S);
  x.fillStyle='rgba(255,255,255,.16)'; x.fillRect(0,0,S,46);
  const label=opLabel(op);
  // подгоняем размер шрифта под ширину
  let fs=380;
  x.font='800 '+fs+'px "Baloo 2", system-ui, sans-serif';
  while(x.measureText(label).width > S*0.86 && fs>120){
    fs-=12; x.font='800 '+fs+'px "Baloo 2", system-ui, sans-serif';
  }
  x.textAlign='center'; x.textBaseline='middle';
  // обводка для читаемости + заливка
  x.lineWidth=fs*0.08; x.strokeStyle='rgba(0,0,0,.25)';
  x.strokeText(label, S/2, S/2+12);
  x.fillStyle='#fff';
  x.fillText(label, S/2, S/2+12);
  const t=new THREE.CanvasTexture(c); t.anisotropy=4; return t;
}
const gates=[]; // {mesh, op, side, z, used}
function buildGates(){
  GATE_DEFS.forEach((pair,gi)=>{
    const z = GATE_Z0 + GATE_DZ*gi;
    pair.forEach((op,si)=>{
      const side = si===0 ? -1 : 1;        // 0=левое
      const grp=new THREE.Group();
      const w=LANE-0.1, h=3.4;
      const panel=new THREE.Mesh(new THREE.PlaneGeometry(w,h),
        new THREE.MeshBasicMaterial({map:gateTexture(op),transparent:true,opacity:.9,side:THREE.DoubleSide}));
      panel.position.set(0,h/2,0);
      // рамка
      const frameMat=new THREE.MeshStandardMaterial({color:opColor(op),emissive:opColor(op),emissiveIntensity:.25});
      const post=new THREE.Mesh(new THREE.BoxGeometry(0.14,h+0.2,0.14),frameMat);
      const postL=post.clone(); postL.position.set(-w/2,h/2,0);
      const postR=post.clone(); postR.position.set(w/2,h/2,0);
      const bar=new THREE.Mesh(new THREE.BoxGeometry(w+0.14,0.14,0.14),frameMat);
      bar.position.set(0,h+0.1,0);
      grp.add(panel,postL,postR,bar);
      grp.position.set(side*(LANE/2), 0, z);
      scene.add(grp);
      gates.push({mesh:grp, op:op, side:side, z:z, used:false, panel:panel});
    });
  });
}

// ---------------------------------------------------------------------------
//  СТЕНЫ + БОСС
// ---------------------------------------------------------------------------
const walls=[]; // {mesh, hp, max, z}
function buildWalls(){
  const wWidth=LANE*2;            // на всю ширину дорожки — перекрывают путь
  for(let i=0;i<WALL_COUNT;i++){
    const z = WALL_Z - i*WALL_SPACING;   // друг за другом вдоль пути
    const shade = i%2 ? '#9aa7c4' : '#aeb9d2';
    const m=new THREE.Mesh(new THREE.BoxGeometry(wWidth,3.4,0.9),
      new THREE.MeshStandardMaterial({color:shade,roughness:.95}));
    m.position.set(0,1.7,z);
    // лицевая «кирпичная» грань (со стороны бегущих)
    const face=new THREE.Mesh(new THREE.BoxGeometry(wWidth+0.04,3.44,0.06),
      new THREE.MeshStandardMaterial({color:'#7b88a8'}));
    face.position.z=0.46; m.add(face);
    // номер стены, чтобы видно сколько осталось пробить
    const lc=document.createElement('canvas'); lc.width=lc.height=128;
    const lx=lc.getContext('2d');
    lx.fillStyle='#fff'; lx.font='800 90px "Baloo 2",sans-serif';
    lx.textAlign='center'; lx.textBaseline='middle';
    lx.fillText(WALL_HP, 64, 70);
    const lbl=new THREE.Mesh(new THREE.PlaneGeometry(2,2),
      new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(lc),transparent:true}));
    lbl.position.set(0,0.2,0.5); m.add(lbl);
    scene.add(m);
    walls.push({mesh:m, hp:WALL_HP, max:WALL_HP, baseY:1.7, z:z});
  }
}
let boss=null;
function buildBoss(){
  boss=new THREE.Group();
  const body=new THREE.Mesh(new THREE.SphereGeometry(2.4,18,14),
    new THREE.MeshStandardMaterial({color:'#c0392b',roughness:.6}));
  body.scale.set(1,1.15,1); body.position.y=2.6;
  const eyeMat=new THREE.MeshStandardMaterial({color:'#fff'});
  const pupMat=new THREE.MeshBasicMaterial({color:'#111'});
  [-0.8,0.8].forEach(sx=>{
    const e=new THREE.Mesh(new THREE.SphereGeometry(0.5,10,10),eyeMat);
    e.position.set(sx,3.4,1.9);
    const p=new THREE.Mesh(new THREE.SphereGeometry(0.22,8,8),pupMat);
    p.position.set(sx*0.95,3.3,2.3);
    boss.add(e,p);
  });
  // рога
  [-1,1].forEach(sx=>{
    const horn=new THREE.Mesh(new THREE.ConeGeometry(0.35,1.3,7),
      new THREE.MeshStandardMaterial({color:'#7a1f15'}));
    horn.position.set(sx*1.2,4.7,0); horn.rotation.z=sx*0.35; boss.add(horn);
  });
  // рот
  const mouth=new THREE.Mesh(new THREE.BoxGeometry(2,0.5,0.3),
    new THREE.MeshBasicMaterial({color:'#3a0d08'}));
  mouth.position.set(0,2.2,2); boss.add(mouth);
  boss.position.set(0,0,BOSS_Z);
  boss.visible=false;
  scene.add(boss);
}

// ---------- ПОБЕДНЫЙ ФИНАЛ: Tung Tung Sahur, «67», бегун по кругу ----------
let celebration=null, celNums=[], celRunner=null;
function bigNumberPlane(txt){
  const c=document.createElement('canvas'); c.width=320; c.height=200;
  const x=c.getContext('2d');
  x.font='800 150px "Baloo 2", system-ui, sans-serif';
  x.textAlign='center'; x.textBaseline='middle';
  x.lineWidth=16; x.strokeStyle='#7a3d00'; x.strokeText(txt,160,108);
  x.fillStyle='#ffc23d'; x.fillText(txt,160,108);
  const m=new THREE.Mesh(new THREE.PlaneGeometry(3.2,2),
    new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(c),transparent:true,depthWrite:false}));
  return m;
}
function buildCelebration(){
  celebration=new THREE.Group(); celNums=[];
  const cz=BOSS_Z;
  // --- Tung Tung Sahur: деревянная дубинка с лицом и битой ---
  const tung=new THREE.Group();
  const wood=new THREE.MeshStandardMaterial({color:'#9c6a33',roughness:.9});
  const woodDark=new THREE.MeshStandardMaterial({color:'#6f4621',roughness:.9});
  const log=new THREE.Mesh(new THREE.CylinderGeometry(0.9,1.0,3.4,14),wood);
  log.position.y=2.0; tung.add(log);
  const rim=new THREE.Mesh(new THREE.CylinderGeometry(0.95,0.95,0.25,14),woodDark);
  rim.position.y=3.5; tung.add(rim);
  // глаза
  const wEye=new THREE.MeshStandardMaterial({color:'#fff'});
  const bEye=new THREE.MeshBasicMaterial({color:'#1a1a1a'});
  [-0.4,0.4].forEach(sx=>{
    const e=new THREE.Mesh(new THREE.SphereGeometry(0.34,12,12),wEye); e.position.set(sx,2.7,0.7);
    const p=new THREE.Mesh(new THREE.SphereGeometry(0.15,8,8),bEye); p.position.set(sx,2.7,1.0);
    tung.add(e,p);
  });
  // брови
  [-0.4,0.4].forEach(sx=>{
    const br=new THREE.Mesh(new THREE.BoxGeometry(0.4,0.1,0.1),bEye);
    br.position.set(sx,3.05,0.85); br.rotation.z=sx>0?-0.25:0.25; tung.add(br);
  });
  // рот
  const mo=new THREE.Mesh(new THREE.BoxGeometry(0.7,0.3,0.1),bEye);
  mo.position.set(0,2.15,0.85); tung.add(mo);
  // ручки-палочки
  const armR=new THREE.Mesh(new THREE.CylinderGeometry(0.09,0.09,1.1,6),woodDark);
  armR.position.set(0.95,2.3,0.2); armR.rotation.z=0.7;
  const armL=armR.clone(); armL.position.x=-0.95; armL.rotation.z=-0.7;
  tung.add(armR,armL);
  // бита в правой руке
  const bat=new THREE.Mesh(new THREE.CylinderGeometry(0.18,0.1,1.4,8),woodDark);
  bat.position.set(1.5,2.9,0.2); bat.rotation.z=0.4;
  tung.add(bat); tung.userData.bat=bat; tung.userData.armR=armR;
  tung.position.set(0,0,cz);
  celebration.add(tung); celebration.userData.tung=tung;

  // --- летающие «67» ---
  for(let i=0;i<3;i++){
    const n=bigNumberPlane('67');
    n.userData.base=new THREE.Vector3((i-1)*3.4, 4.5+ (i%2)*1.2, cz-1);
    n.userData.ph=i*2.1;
    celebration.add(n); celNums.push(n);
  }

  // --- человечек, бегающий по кругу ---
  celRunner=new THREE.Group();
  const rb=new THREE.Mesh(new THREE.CylinderGeometry(0.3,0.34,1.0,8),
    new THREE.MeshStandardMaterial({color:'#2f7bff',roughness:.6}));
  rb.position.y=0.65;
  const rh=new THREE.Mesh(new THREE.SphereGeometry(0.3,10,10),skinMat); rh.position.y=1.35;
  const legMat=new THREE.MeshStandardMaterial({color:'#1f3a8a'});
  const lg1=new THREE.Mesh(new THREE.BoxGeometry(0.16,0.5,0.16),legMat); lg1.position.set(-0.16,0.25,0);
  const lg2=lg1.clone(); lg2.position.x=0.16;
  celRunner.add(rb,rh,lg1,lg2); celRunner.userData.legs=[lg1,lg2];
  celebration.add(celRunner);

  celebration.visible=false;
  scene.add(celebration);
}

// ---------------------------------------------------------------------------
//  ИГРОВОЕ СОСТОЯНИЕ
// ---------------------------------------------------------------------------
let state='menu'; // menu | run | walls | boss | done
let count=START_COUNT;
let crowdX=0, targetX=0, crowdZ=0;
let timer=0;          // таймер фаз
let finalArmy=0, wallsCleared=0, bossWin=false;
const keys={};

const elCount=document.getElementById('count');
const elBanner=document.getElementById('banner');
const elProgress=document.querySelector('#progress i');
const elHint=document.getElementById('hint');

function setCount(n, dir){
  count=Math.max(0,Math.round(n));
  elCount.firstChild.nodeValue=count;
  elCount.style.color = dir>0 ? '#aaffe0' : dir<0 ? '#ffc1cf' : '#fff';
  elCount.classList.remove('bump'); void elCount.offsetWidth; elCount.classList.add('bump');
  setTimeout(()=>elCount.style.color='#fff',180);
}
function banner(txt){
  elBanner.textContent=txt;
  elBanner.classList.remove('show'); void elBanner.offsetWidth; elBanner.classList.add('show');
}
function applyOp(op){
  const before=count; let n=count;
  if(op.t==='add') n+=op.v;
  else if(op.t==='sub') n-=op.v;
  else if(op.t==='mul') n*=op.v;
  else if(op.t==='div') n=Math.floor(n/op.v);
  setCount(n, n-before);
}

// ---------------------------------------------------------------------------
//  УПРАВЛЕНИЕ
// ---------------------------------------------------------------------------
addEventListener('keydown',e=>{keys[e.key.toLowerCase()]=true;});
addEventListener('keyup',e=>{keys[e.key.toLowerCase()]=false;});
let dragging=false;
function pointerX(clientX){ return (clientX/innerWidth*2-1)*LANE; }
renderer.domElement.addEventListener('pointerdown',e=>{dragging=true;targetX=pointerX(e.clientX);});
addEventListener('pointermove',e=>{if(dragging)targetX=pointerX(e.clientX);});
addEventListener('pointerup',()=>dragging=false);

// ---------------------------------------------------------------------------
//  ОБНОВЛЕНИЕ
// ---------------------------------------------------------------------------
function placeCrowd(dt, running){
  blob.position.set(crowdX,0.03,crowdZ);
  const vis=Math.min(count,MAX_VISIBLE);
  const spread=Math.min(1+count*0.012,2.2);
  for(let i=0;i<runners.length;i++){
    const r=runners[i];
    if(i<vis){
      r.visible=true;
      const s=slots[i];
      r.position.x=crowdX + s[0]*spread + Math.sin(performance.now()*0.001+i)*0.03;
      r.position.z=crowdZ + s[1]*spread;
      if(running){
        r.userData.phase += dt*16;
        r.position.y=Math.abs(Math.sin(r.userData.phase))*0.18;
        r.rotation.z=Math.sin(r.userData.phase)*0.08;
      }
      r.rotation.y=Math.PI; // лицом вперёд (к -z камера сзади)
    } else r.visible=false;
  }
}
function updateCamera(){
  const camTargetX=crowdX*0.5;
  camera.position.x += (camTargetX-camera.position.x)*0.1;
  camera.position.y=7.2;
  camera.position.z=crowdZ+11;
  camera.lookAt(crowdX*0.3, 1.5, crowdZ-8);
}

function animateCelebration(dt){
  if(!celebration || !celebration.visible) return;
  celebration.userData.t=(celebration.userData.t||0)+dt;
  const t=celebration.userData.t;
  const tung=celebration.userData.tung;
  // Tung Tung Sahur пляшет
  tung.position.y=Math.abs(Math.sin(t*7))*0.35;
  tung.rotation.z=Math.sin(t*7)*0.2;
  tung.rotation.y=Math.sin(t*2.2)*0.4;
  tung.userData.armR.rotation.z=0.7+Math.sin(t*12)*0.6;
  tung.userData.bat.rotation.z=0.4+Math.sin(t*12)*0.6;
  // «67» летают и смотрят в камеру
  celNums.forEach(n=>{
    const b=n.userData.base, ph=n.userData.ph;
    n.position.set(b.x+Math.sin(t*1.6+ph)*1.4, b.y+Math.sin(t*3+ph)*0.6, b.z+Math.cos(t*1.6+ph)*1.0);
    const s=1+Math.sin(t*5+ph)*0.12; n.scale.set(s,s,s);
    n.lookAt(camera.position);
  });
  // человечек бегает по кругу
  const ang=t*2.4, R=4.2, cz=BOSS_Z+2.5;
  celRunner.position.set(Math.cos(ang)*R, Math.abs(Math.sin(t*16))*0.12, cz+Math.sin(ang)*R);
  celRunner.rotation.y=-ang+Math.PI/2;
  const sw=Math.sin(t*16)*0.6;
  celRunner.userData.legs[0].rotation.x=sw;
  celRunner.userData.legs[1].rotation.x=-sw;
}

function update(dt){
  if(state==='run'){
    // управление
    if(keys['arrowleft']||keys['a']) targetX-=RUN_SPEED*1.4*dt;
    if(keys['arrowright']||keys['d']) targetX+=RUN_SPEED*1.4*dt;
    targetX=Math.max(-LANE,Math.min(LANE,targetX));
    crowdX += (targetX-crowdX)*Math.min(1,dt*9);
    crowdZ -= RUN_SPEED*dt;

    // ворота
    for(const g of gates){
      if(!g.used && crowdZ <= g.z){
        // какое из пары соответствует положению толпы?
        const inThisHalf = (g.side<0 && crowdX<0) || (g.side>0 && crowdX>=0);
        // помечаем оба ворота пары пройденными, применяем только нужное
        if(inThisHalf){ applyOp(g.op); g.mesh.children[0].material.opacity=0.25; }
        g.used=true;
      }
    }
    // прогресс
    const p=Math.min(1, crowdZ/WALL_Z);
    elProgress.style.width=(p*100)+'%';

    if(crowdZ<=WALL_Z+1){
      crowdZ=WALL_Z+1.4;
      finalArmy=count;
      enterWalls();
    }
  }
  else if(state==='walls'){
    timer+=dt;
    const stepT=0.55;
    const knocked=Math.min(wallsCleared, Math.floor(timer/stepT));
    // куда бежит толпа: вплотную к первой устоявшей стене, либо насквозь
    let targetZ;
    if(knocked < WALL_COUNT) targetZ = walls[knocked].z + 2.4;
    else targetZ = walls[WALL_COUNT-1].z - 3.6;
    crowdZ += (targetZ - crowdZ)*Math.min(1,dt*3.5);
    // валим стены по очереди (ближняя -> дальняя)
    for(let i=0;i<walls.length;i++){
      const w=walls[i];
      if(i<knocked){                       // уже повалена
        w.mesh.rotation.x=-1.45; w.mesh.position.set(0,0.3,w.z-1.3); w.hp=0;
      } else if(i===knocked && i<wallsCleared){  // валится прямо сейчас
        const t2=Math.min(1,(timer-i*stepT)/stepT);
        w.mesh.rotation.x=-1.45*t2;
        w.mesh.position.set(0, w.baseY-(w.baseY-0.3)*t2, w.z-1.3*t2);
        w.hp=w.max*(1-t2);
      } else {                              // стоит
        w.mesh.rotation.x=0; w.mesh.position.set(0,w.baseY,w.z);
      }
    }
    const done = (wallsCleared>=WALL_COUNT)
      ? timer > WALL_COUNT*stepT + 0.5
      : timer > wallsCleared*stepT + 1.2;
    if(done){
      if(wallsCleared>=WALL_COUNT) enterBoss();
      else finish(false,'walls');
    }
  }
  else if(state==='boss'){
    timer+=dt;
    crowdZ += (BOSS_Z+5 - crowdZ)*Math.min(1,dt*2.5);
    if(!boss.userData.resolved){
      boss.position.y=Math.sin(timer*4)*0.15;
      if(timer>0.8 && timer<2.4) placeCrowd(dt,true);  // налетают
      if(timer>2.4){
        boss.userData.resolved=true;
        bossWin = finalArmy>=BOSS_HP;
        if(bossWin){
          banner('БОСС ПОВЕРЖЕН!');
          celebration.visible=true; celebration.userData.t=0;
          setTimeout(()=>banner('ТУНГ ТУНГ ТУНГ САХУР!  67'),1500);
        } else banner('Босс слишком силён…');
      }
    } else if(bossWin){
      // босс улетает, начинается праздник
      boss.scale.multiplyScalar(Math.max(0.001,1-dt*2.2));
      boss.rotation.y+=dt*6; boss.position.y+=dt*2.6;
      if(timer>3.0) boss.visible=false;
      animateCelebration(dt);
      if(timer>6.8) finish(true,'boss');
    } else {
      boss.scale.x=boss.scale.z=1+Math.sin(timer*20)*0.05;
      if(timer>3.6) finish(false,'boss');
    }
  }
  placeCrowd(dt, state==='run');
  updateCamera();
}

// ---------------------------------------------------------------------------
//  ПЕРЕХОДЫ ФАЗ
// ---------------------------------------------------------------------------
function enterWalls(){
  state='walls'; timer=0;
  wallsCleared=Math.min(WALL_COUNT, Math.floor(finalArmy/WALL_HP));
  elHint.classList.remove('show');
  banner(finalArmy>=TOTAL_WALL_HP ? 'ШТУРМ СТЕН!' : 'Стен слишком много!');
}
function enterBoss(){
  state='boss'; timer=0; boss.visible=true;
  boss.userData.resolved=false; boss.scale.setScalar(1);
  banner('БОСС!');
}
function finish(win,reason){
  state='done';
  // экран результата
  document.getElementById('rArmy').textContent=finalArmy;
  document.getElementById('rWalls').textContent=wallsCleared+' / '+WALL_COUNT;
  const v=document.getElementById('verdict');
  const txt=document.getElementById('resultText');
  const bossCell=document.getElementById('rBoss');
  if(reason==='walls'){
    v.textContent='Не пробились'; v.className='verdict lose';
    txt.textContent='Армия из '+finalArmy+' не смогла снести все стены. Нужно минимум '+TOTAL_WALL_HP+' человечков. Ищи зелёные «+» и золотые «×»!';
    bossCell.textContent='не дошли';
  } else if(win){
    v.textContent='ПОБЕДА!'; v.className='verdict win';
    txt.textContent='Армия из '+finalArmy+' человечков снесла стены и одолела босса! Чисто.';
    bossCell.textContent='повержен';
  } else {
    v.textContent='Поражение'; v.className='verdict lose';
    txt.textContent='Стены пали, но против босса не хватило сил. Для победы нужно ≥ '+BOSS_HP+' человечков.';
    bossCell.textContent='не побеждён';
  }
  setTimeout(()=>document.getElementById('result').classList.remove('hidden'),700);
}

// ---------------------------------------------------------------------------
//  СТАРТ / РЕСТАРТ
// ---------------------------------------------------------------------------
function buildLevel(){
  gates.forEach(g=>scene.remove(g.mesh)); gates.length=0;
  walls.forEach(w=>scene.remove(w.mesh)); walls.length=0;
  if(boss) scene.remove(boss);
  if(celebration) scene.remove(celebration);
  buildGates(); buildWalls(); buildBoss(); buildCelebration();
}
function startGame(){
  buildLevel();
  count=START_COUNT; setCount(count,0);
  crowdX=targetX=0; crowdZ=0; timer=0;
  finalArmy=0; wallsCleared=0; bossWin=false;
  camera.position.set(0,7.2,11);
  state='run';
  elProgress.style.width='0%';
  elHint.classList.add('show');
}
document.getElementById('play').onclick=()=>{
  document.getElementById('start').classList.add('hidden');
  startGame();
};
document.getElementById('again').onclick=()=>{
  document.getElementById('result').classList.add('hidden');
  startGame();
};

// ---------------------------------------------------------------------------
//  ЦИКЛ
// ---------------------------------------------------------------------------
function resize(){
  const w=innerWidth,h=innerHeight;
  renderer.setSize(w,h); camera.aspect=w/h; camera.updateProjectionMatrix();
}
addEventListener('resize',resize); resize();

let last=performance.now();
function loop(now){
  const dt=Math.min(0.05,(now-last)/1000); last=now;
  if(state!=='menu') update(dt);
  else { // лёгкое вращение для меню
    camera.position.set(Math.sin(now*0.0003)*4,7,14);
    camera.lookAt(0,1.5,-6);
    placeCrowd(dt,false);
  }
  renderer.render(scene,camera);
  requestAnimationFrame(loop);
}
// небольшая толпа на превью меню
buildLevel(); crowdZ=-2; count=6; placeCrowd(0,false);
requestAnimationFrame(loop);

})();
</script>
</body>
